[Unit]
Description=Digital Gimbal 1CH_SUPER (NanoTrack + Hailo)
Documentation=file:/home/dbai/digital-gimbal/1CH_SUPER/digital_gimbal.py
After=network.target
Wants=network.target
Conflicts=digital-gimbal.service video_processing.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Environment=CAP_W=1920
Environment=CAP_H=1080
Environment=CAP_FPS=30
Environment=CAP_DEV_FPS=60
Environment=FAST_CORES=0,1,3
Environment=WDG_FRAME_TIMEOUT_S=0.15
Environment=DEADBAND_FRAC=0.05
Environment=FCC_PORT=/dev/ttyAMA3
Environment=FCC_BAUD=115200
Environment=RTSP_PORT=554
Environment=RTSP_W=1280
Environment=RTSP_H=720
Environment=RTSP_FPS=30
Environment=RTSP_GOP=30
Environment=RTSP_INTRA_REFRESH=0
Environment=RTSP_QUEUE=1
Environment=RTSP_BITRATE=1500
Environment=RTSP_PRESET=veryfast
Environment=RTSP_CODEC=h264
Type=simple
User=dbai
Group=dbai
WorkingDirectory=/home/dbai/digital-gimbal/1CH_SUPER

AmbientCapabilities=CAP_NET_BIND_SERVICE

ExecStartPre=/home/dbai/digital-gimbal/1CH_SUPER/gimbal-camera-ready.sh

ExecStart=/home/dbai/.venv-gimbal/bin/python -u /home/dbai/digital-gimbal/1CH_SUPER/digital_gimbal.py

Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=15
KillMode=control-group

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
