[Unit]
Description=Digital Gimbal 4CH (Arducam CamArray, imx708 x4 muxed)
Documentation=file:/home/gimbal/4CH/digital_gimbal.py
After=network.target
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=gimbal
Group=gimbal
WorkingDirectory=/home/gimbal

AmbientCapabilities=CAP_NET_BIND_SERVICE

ExecStartPre=+/home/gimbal/4CH/gimbal-camera-ready.sh

ExecStart=/home/gimbal/.venv-gimbal/bin/python -u /home/gimbal/4CH/digital_gimbal.py

Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=15
KillMode=control-group

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
