[Unit]
Description=Digital Gimbal 1CH (single imx708 / Camera Module 3)
Documentation=file:/home/gimbal/1CH/digital_gimbal.py
After=network.target
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Environment=STATUS_FILE=/dev/shm/gimbal-status.json
Environment=FCC_PORT=/dev/ttyAMA3
Environment=FCC_BAUD=115200
Environment=FCC_HZ=50
Environment=CAM_BACKEND=v4l2
Environment=RTSP_FPS=12
Environment=STAB_FREE=1
Environment=STAB_FREE_PX=200
Environment=STAB_TAU=1.5
Environment=OUT_W=1920
Environment=OUT_H=1080
Environment=LFC_RATE=24
Environment=RTSP_BITRATE=2500
Environment=RTSP_PRESET=veryfast
Environment=RTSP_CODEC=h264
Environment=RTSP_X265_OPTS=no-rect=1:no-amp=1:wpp=1:pmode=1:pme=1:frame-threads=4:rd=1:me=0:subme=0
Type=simple
User=gimbal
Group=gimbal
WorkingDirectory=/home/gimbal

AmbientCapabilities=CAP_NET_BIND_SERVICE

ExecStartPre=+/home/gimbal/1CH/gimbal-camera-ready.sh

ExecStart=/home/gimbal/.venv-gimbal/bin/python -u /home/gimbal/1CH/digital_gimbal.py

Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=15
KillMode=control-group

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
